        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"custom_tags\" (\"key\" TEXT NOT NULL, \"label\" TEXT NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    },
