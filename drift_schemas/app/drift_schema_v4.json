    {
      "name": "day_logs",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"day_logs\" (\"date\" TEXT NOT NULL, \"flow\" TEXT NOT NULL DEFAULT 'none', \"mucus\" TEXT NULL, \"bbt\" REAL NULL, \"bbt_disturbed\" INTEGER NOT NULL DEFAULT 0 CHECK (\"bbt_disturbed\" IN (0, 1)), \"lh_test\" TEXT NULL, \"pregnancy_test\" TEXT NULL, \"note\" TEXT NULL, \"products\" INTEGER NULL, \"energy\" TEXT NULL, \"sleep_hours\" REAL NULL, \"weight_kg\" REAL NULL, PRIMARY KEY (\"date\"));"
        }
      ]
    },
    {
      "name": "symptom_entries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"symptom_entries\" (\"date\" TEXT NOT NULL, \"symptom\" TEXT NOT NULL, \"severity\" INTEGER NOT NULL DEFAULT 1, PRIMARY KEY (\"date\", \"symptom\"));"
        }
      ]
    },
    {
      "name": "sex_entries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"sex_entries\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"date\" TEXT NOT NULL, \"kind\" TEXT NOT NULL DEFAULT 'partnered', \"minute_of_day\" INTEGER NULL, \"protection\" TEXT NULL, \"orgasm\" INTEGER NULL CHECK (\"orgasm\" IN (0, 1)), \"note\" TEXT NULL);"
        }
      ]
    },
    {
